{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sceau values",
  "type": "object",
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 1, "default": 2 },
    "namespace": { "type": "string", "default": "hnoel-dev" },
    "name": { "type": "string", "default": "sceau" },

    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "default": "ghcr.io/hnoel/sceau" },
        "tag": { "type": "string", "default": "main" },
        "pullPolicy": { "type": "string", "default": "IfNotPresent" }
      },
      "additionalProperties": false
    },

    "imagePullSecrets": {
      "type": "array",
      "items": { "type": "object", "properties": { "name": { "type": "string" } }, "required": ["name"] }
    },

    "nameOverride": { "type": "string", "default": "" },
    "fullnameOverride": { "type": "string", "default": "" },

    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean", "default": true },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" }, "default": {} },
        "name": { "type": "string", "default": "" }
      },
      "additionalProperties": false
    },

    "podAnnotations": { "type": "object", "additionalProperties": { "type": "string" }, "default": {} },
    "podSecurityContext": { "type": "object", "default": {} },
    "securityContext": { "type": "object", "default": {} },

    "service": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "default": "ClusterIP" },
        "extHttpPort": { "type": "integer", "default": 80, "minimum": 1, "maximum": 65535 },
        "intHttpPort": { "type": "integer", "default": 8080, "minimum": 1, "maximum": 65535 }
      },
      "additionalProperties": false
    },

    "sceau": {
      "type": "object",
      "properties": {
        "typeBd": { "type": "string", "default": "mysql" },
        "version": { "type": "string", "default": "debug" },
        "date": { "type": "string", "default": "01/01/1970" }
      },
      "additionalProperties": false
    },

    "httpd": {
      "type": "object",
      "properties": {
        "pullPolicy": { "type": "string", "default": "IfNotPresent" }
      },
      "additionalProperties": false
    },

    "resources": { "type": "object", "default": {} },

    "route": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "host": { "type": "string", "default": "example.com" },
        "tls": { "type": "boolean", "default": true },
        "resources": { "type": "object", "default": {} }
      },
      "additionalProperties": false
    },

    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "minReplicas": { "type": "integer", "default": 1, "minimum": 1 },
        "maxReplicas": { "type": "integer", "default": 100, "minimum": 1 },
        "targetCPUUtilizationPercentage": { "type": "integer", "default": 80, "minimum": 1, "maximum": 100 }
      },
      "additionalProperties": false
    },

    "nodeSelector": { "type": "object", "additionalProperties": { "type": "string" }, "default": {} },
    "tolerations": { "type": "array", "items": { "type": "object" }, "default": [] },
    "affinity": { "type": "object", "default": {} },

    "env": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "value": { "type": "string" }
        },
        "required": ["name", "value"],
        "additionalProperties": false
      },
      "default": [
        { "name": "MARIADB_DATABASE", "value": "change_me" },
        { "name": "MARIADB_USER", "value": "change_me" },
        { "name": "MARIADB_PASSWORD", "value": "change_me" },
        { "name": "MARIADB_ROOT_PASSWORD", "value": "change_me" }
      ]
    },

    "secret": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "default": "scean.secrets" }
      },
      "additionalProperties": false
    },

    "mariadb": {
      "type": "object",
      "properties": {
        "replicaCount": { "type": "integer", "default": 1, "minimum": 1 },
        "image": {
          "type": "object",
          "properties": {
            "registry": { "type": "string", "default": "docker.io" },
            "repository": { "type": "string", "default": "bitnami/mariadb" },
            "tag": { "type": "string", "default": "latest" },
            "pullPolicy": { "type": "string", "default": "IfNotPresent" }
          },
          "additionalProperties": false
        },
        "architecture": { "type": "string", "default": "standalone" },

        "auth": {
          "type": "object",
          "properties": {
            "database": { "type": "string", "default": "appdb" },
            "username": { "type": "string", "default": "appuser" },
            "password": { "type": "string", "default": "change-me" },
            "rootPassword": { "type": "string", "default": "change-me-root" },
            "initdbScripts": { "type": "object", "default": {} }
          },
          "additionalProperties": false
        },

        "tde": {
          "type": "object",
          "properties": { "enabled": { "type": "boolean", "default": false } },
          "additionalProperties": false
        },

        "primary": {
          "type": "object",
          "properties": {
            "name": { "type": "string", "default": "mariadb" }
          },
          "additionalProperties": false
        },

        "service": {
          "type": "object",
          "properties": {
            "type": { "type": "string", "default": "ClusterIP" },
            "ports": {
              "type": "object",
              "properties": { "mysql": { "type": "integer", "default": 3306, "minimum": 1, "maximum": 65535 } },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },

        "persistence": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "storageClass": { "type": "string", "default": "standard" },
            "size": { "type": "string", "default": "1Gi" }
          },
          "additionalProperties": false
        },

        "resources": {
          "type": "object",
          "properties": {
            "limits": {
              "type": "object",
              "properties": {
                "cpu": { "type": "string", "default": "1" },
                "memory": { "type": "string", "default": "1Gi" }
              },
              "additionalProperties": true
            },
            "requests": {
              "type": "object",
              "properties": {
                "cpu": { "type": "string", "default": "250m" },
                "memory": { "type": "string", "default": "256Mi" }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
