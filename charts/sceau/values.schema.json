{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/hnoel/helm/blob/main/charts/sceau/values.schema.json",
  "title": "Project 'Sceau' Helm Chart Values",
  "description": "This project is a 3 contaniner stack: httpd, php-fpm and database",
  "type": "object",
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 0, "default": 2, "description": "Number of pod replicas. Set to 0 to scale down." },
    "namespace": { "type": "string", "default": "hnoel-dev" },
    "name": { "type": "string", "default": "sceau" },

    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "default": "ghcr.io/hnoel/sceau" },
        "tag": { "type": "string", "default": "main", "description": "Image tag. Avoid using 'latest' in production." },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"], "default": "IfNotPresent", "description": "Image tag. Avoid using 'latest' in production." }
      },
      "additionalProperties": false
    },

    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
	"description": "Registry secret names as an array",
        "properties": {
          "name": { "type": "string", "default": "my-registry" }
        },
        "required": ["name"],
        "additionalProperties": false
      },
      "default": [{ "name": "my-registry" }]
    },

    "nameOverride": { "type": "string", "default": "" },
    "fullnameOverride": { "type": "string", "default": "" },

    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean", "default": true },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" }, "default": {} },
        "name": { "type": "string", "default": "" }
      },
      "additionalProperties": false
    },

    "podAnnotations": { "type": "object", "additionalProperties": { "type": "string" }, "default": {} },
    "podSecurityContext": { "type": "object", "default": {}, "additionalProperties": true },
    "securityContext": { "type": "object", "default": {}, "additionalProperties": true },

    "service": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "default": "ClusterIP" },
        "extHttpPort": { "type": "integer", "minimum": 1, "maximum": 65535, "default": 8088 },
        "intHttpPort": { "type": "string"}
      },
      "additionalProperties": false
    },

    "sceau": {
      "type": "object",
      "properties": {
        "typeBd": { "type": "string", "default": "mysql" },
        "version": { "type": "string", "default": "debug" },
        "date": { "type": "string", "default": "01/01/1970" }
      },
      "additionalProperties": false
    },

    "httpd": {
      "type": "object",
      "properties": {
        "pullPolicy": { "type": "string", "default": "IfNotPresent" }
      },
      "additionalProperties": true
    },

    "resources": { "type": "object", "default": {}, "additionalProperties": true },

    "route": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "host": { "type": "string", "default": "example.com" },
        "tls": { "type": "boolean", "default": true },
        "resources": { "type": "object", "default": {}, "additionalProperties": true }
      },
      "additionalProperties": false
    },

    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "minReplicas": { "type": "integer", "minimum": 1, "default": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1, "default": 100 },
        "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 1, "maximum": 100, "default": 80 }
      },
      "additionalProperties": false,
      "if": {
        "properties": {
          "enabled": { "const": true }
        },
        "required": ["enabled"]
      },
      "then": {
        "required": ["minReplicas", "maxReplicas"]
      }
    },

    "nodeSelector": { "type": "object", "additionalProperties": { "type": "string" }, "default": {} },
    "tolerations": { "type": "array", "items": { "type": "object" }, "default": [] },
    "affinity": { "type": "object", "default": {}, "additionalProperties": true },

    "env": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "value": { "type": "string" }
        },
        "required": ["name", "value"],
        "additionalProperties": false
      },
      "default": [
        { "name": "MARIADB_DATABASE", "value": "change_me" },
        { "name": "MARIADB_USER", "value": "change_me" },
        { "name": "MARIADB_PASSWORD", "value": "change_me" },
        { "name": "MARIADB_ROOT_PASSWORD", "value": "change_me" }
      ]
    },

    "secret": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "default": "sceau.secrets" }
      },
      "additionalProperties": false
    },

    "mariadb": {
      "$ref": "https://raw.githubusercontent.com/bitnami/charts/refs/heads/main/bitnami/mariadb/values.schema.json"
    }
  },
  "additionalProperties": true
}
